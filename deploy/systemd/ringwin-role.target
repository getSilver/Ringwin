[Unit]
Description=RingWin production role group
Wants=ringwin-role@engine.service
Wants=ringwin-role@market_feed.service
Wants=ringwin-role@execution_gateway.service
Wants=ringwin-role@telemetry.service
Wants=ringwin-role@control_fence.service
After=ringwin-role@engine.service ringwin-role@market_feed.service ringwin-role@execution_gateway.service ringwin-role@telemetry.service ringwin-role@control_fence.service

[Install]
WantedBy=multi-user.target
