# Copy this file to .env.local and fill in the Demo Trading credentials.
# Never commit .env.local or paste its values into logs or chat.
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET_KEY=
OKX_DEMO_PASSPHRASE=

# Adjust these values if the Demo account belongs to another OKX entity.
OKX_DEMO_REST_BASE_URL=https://openapi.okx.com
OKX_ENTITY=global
