              "closedPnl": "0",
              "hash": "0x3333333333333333333333333333333333333333333333333333333333333333",
              "oid": 123,
              "crossed": true,
              "fee": "0.035",
              "tid": 456,
              "feeToken": "USDC",
              "builderFee": "0"
            }
          ]
        }
